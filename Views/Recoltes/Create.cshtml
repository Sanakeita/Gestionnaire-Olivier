@model Recolte
@{
    ViewData["Title"] = T["Nouvelle récolte"];
}
<h1>@T["Nouvelle récolte"]</h1>
<p class="lede">@T["Une seule récolte par olivier et par année."]</p>
<form asp-action="Create" method="post" class="panel">
    <partial name="_Form" />
    <div class="toolbar">
        <button type="submit">@T["Enregistrer"]</button>
        <a class="btn secondary" asp-action="Index">@T["Annuler"]</a>
    </div>
</form>
