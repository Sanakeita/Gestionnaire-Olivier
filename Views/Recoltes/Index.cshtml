@model IEnumerable<Recolte>
@{
    ViewData["Title"] = T["Récoltes"];
}
<div class="toolbar">
    <div>
        <h1>@T["Récoltes"]</h1>
        <p class="lede">@T["Une seule récolte par olivier et par année."]</p>
    </div>
    <a class="btn" asp-action="Create">@T["Nouvelle récolte"]</a>
</div>
<form method="get" class="panel filters">
    <div>
        <label>@T["Année"]</label>
        <select name="annee" asp-items="ViewBag.Annees">
            <option value="">@T["Toutes les années"]</option>
        </select>
    </div>
    <div>
        <label>@T["Champ"]</label>
        <select name="champId" asp-items="ViewBag.Champs">
            <option value="">@T["Tous les champs"]</option>
        </select>
    </div>
    <button type="submit">@T["Filtrer"]</button>
</form>
<div class="table-wrap">
    <table>
        <thead>
            <tr>
                <th>@T["Année"]</th>
                <th>@T["Olivier"]</th>
                <th>@T["Champ"]</th>
                <th>@T["Quantité"]</th>
                <th>@T["Date"]</th>
                <th>@T["Qualité"]</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var recolte in Model)
        {
            <tr>
                <td>@recolte.Annee</td>
                <td>@recolte.Olivier?.Code</td>
                <td>@recolte.Olivier?.Champ?.Nom</td>
                <td>@recolte.QuantiteKg.ToString("N1") kg</td>
                <td>@(recolte.DateRecolte?.ToString("d") ?? "—")</td>
                <td>@T[recolte.Qualite ?? ""]</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@recolte.Id">@T["Modifier"]</a> ·
                    <a asp-action="Delete" asp-route-id="@recolte.Id">@T["Supprimer"]</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
