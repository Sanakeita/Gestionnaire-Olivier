@model Recolte
@{
    ViewData["Title"] = T["Modifier la récolte"];
}
<h1>@T["Modifier la récolte"]</h1>
<form asp-action="Edit" method="post" class="panel">
    <input type="hidden" asp-for="Id" />
    <partial name="_Form" />
    <div class="toolbar">
        <button type="submit">@T["Enregistrer"]</button>
        <a class="btn secondary" asp-action="Index">@T["Annuler"]</a>
    </div>
</form>
