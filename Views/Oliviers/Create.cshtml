@model Olivier
@{
    ViewData["Title"] = T["Nouvel olivier"];
}
<h1>@T["Nouvel olivier"]</h1>
<form asp-action="Create" method="post" class="panel">
    <partial name="_Form" />
    <div class="toolbar">
        <button type="submit">@T["Enregistrer"]</button>
        <a class="btn secondary" asp-action="Index">@T["Annuler"]</a>
    </div>
</form>
