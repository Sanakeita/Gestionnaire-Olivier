@model IEnumerable<Olivier>
@{
    ViewData["Title"] = T["Oliviers"];
}
<div class="toolbar">
    <div>
        <h1>@T["Oliviers"]</h1>
        <p class="lede">@T["Chaque arbre produit une récolte par an."]</p>
    </div>
    <a class="btn" asp-action="Create">@T["Nouvel olivier"]</a>
</div>
<form method="get" class="panel filters">
    <div>
        <label>@T["Champ"]</label>
        <select name="champId" asp-items="ViewBag.Champs">
            <option value="">@T["Tous les champs"]</option>
        </select>
    </div>
    <button type="submit">@T["Filtrer"]</button>
</form>
<div class="table-wrap">
    <table>
        <thead>
            <tr>
                <th>@T["Identifiant"]</th>
                <th>@T["Champ"]</th>
                <th>@T["Variété"]</th>
                <th>@T["Plantation"]</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var olivier in Model)
        {
            <tr>
                <td>@olivier.Code</td>
                <td>@olivier.Champ?.Nom</td>
                <td>@olivier.Variete</td>
                <td>@(olivier.AnneePlantation?.ToString() ?? "—")</td>
                <td>
                    <a asp-action="Details" asp-route-id="@olivier.Id">@T["Détail"]</a> ·
                    <a asp-action="Edit" asp-route-id="@olivier.Id">@T["Modifier"]</a> ·
                    <a asp-action="Delete" asp-route-id="@olivier.Id">@T["Supprimer"]</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
